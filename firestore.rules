rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'authProvider', 'onboardingCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'authProvider', 'onboardingCompleted', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 100000))
        && data.authProvider is string
        && data.authProvider in ['google', 'apple', 'email', 'anonymous']
        && data.onboardingCompleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll([
          'userId', 'theme', 'accentColor', 'language', 'chatDensity', 'fontSize',
          'typingSpeed', 'hapticsEnabled', 'soundEnabled', 'notificationsEnabled',
          'featureAnnouncements', 'accountAlerts', 'autoSaveHistory', 'hidePreviews', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'theme', 'accentColor', 'language', 'chatDensity', 'fontSize',
          'typingSpeed', 'hapticsEnabled', 'soundEnabled', 'notificationsEnabled',
          'featureAnnouncements', 'accountAlerts', 'autoSaveHistory', 'hidePreviews', 'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.theme is string && data.theme in ['dark', 'light']
        && data.accentColor is string && data.accentColor in ['mono', 'blue', 'emerald', 'amber', 'rose', 'violet']
        && data.language is string && data.language in ['en', 'ar']
        && data.chatDensity is string && data.chatDensity in ['comfortable', 'compact']
        && data.fontSize is string && data.fontSize in ['sm', 'md', 'lg']
        && data.typingSpeed is string && data.typingSpeed in ['fast', 'natural', 'instant']
        && data.hapticsEnabled is bool
        && data.soundEnabled is bool
        && data.notificationsEnabled is bool
        && data.featureAnnouncements is bool
        && data.accountAlerts is bool
        && data.autoSaveHistory is bool
        && data.hidePreviews is bool
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'body', 'category', 'read', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'body', 'category', 'read', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 600
        && data.category is string && data.category in ['feature', 'account', 'system']
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'customTitle', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'title', 'customTitle', 'createdAt', 'updatedAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.customTitle is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId, conversationId) {
      return data.keys().hasAll(['userId', 'conversationId', 'role', 'text', 'createdAt'])
        && data.keys().hasOnly(['userId', 'conversationId', 'role', 'text', 'createdAt'])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.conversationId is string
        && isValidId(data.conversationId)
        && data.conversationId == conversationId
        && data.role is string
        && data.role in ['user', 'model']
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 32000
        && data.createdAt is timestamp;
    }

    // Private User Profiles (strictly isolated to account owner)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'photoUrl', 'authProvider', 'onboardingCompleted', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private User Settings & Personalization
      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
        allow list: if false;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserSettings(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidUserSettings(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'theme', 'accentColor', 'language', 'chatDensity', 'fontSize',
            'typingSpeed', 'hapticsEnabled', 'soundEnabled', 'notificationsEnabled',
            'featureAnnouncements', 'accountAlerts', 'autoSaveHistory', 'hidePreviews', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
      }

      // Private User Notifications
      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(notificationId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(notificationId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidNotification(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(notificationId)
          && isValidNotification(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(notificationId);
      }

      // Private User Conversations
      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(conversationId)
          && isValidConversation(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(conversationId)
          && isValidConversation(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'customTitle', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);

        // Private Conversation Messages
        match /messages/{messageId} {
          allow get: if isOwner(userId)
            && isValidId(userId)
            && isValidId(conversationId)
            && isValidId(messageId);
          allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
          allow create: if isOwner(userId)
            && isValidId(userId)
            && isValidId(conversationId)
            && isValidId(messageId)
            && exists(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId))
            && isValidChatMessage(incoming(), userId, conversationId)
            && incoming().createdAt == request.time;
          allow update: if false;
          allow delete: if isOwner(userId)
            && isValidId(userId)
            && isValidId(conversationId)
            && isValidId(messageId);
        }
      }
    }
  }
}
